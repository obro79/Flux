# Local development defaults. Copy to .env and adjust as needed.
# Production values live in .env.production (see .env.production.example).

# Storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379

# Kafka (docker compose exposes the broker on localhost:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Public API surface returned by GET /markets
SUPPORTED_EXCHANGES=coinbase,kraken,demo
SUPPORTED_PRODUCTS=BTC-USD,ETH-USD,SOL-USD

# Per-client request limit on public routes (0 disables it)
RATE_LIMIT_PER_MINUTE=120

# Deterministic "demo" exchange publisher (scripts/demo_fallback_publisher.py)
DEMO_FALLBACK_ENABLED=true
DEMO_PRODUCT_IDS=BTC-USD,ETH-USD,SOL-USD
DEMO_FALLBACK_INTERVAL_SECONDS=5
